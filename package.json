{
  "name": "markdown-it-bracketed-spans",
  "version": "1.0.2",
  "description": "<span> tag for markdown-it markdown parser.",
  "type": "module",
  "keywords": [
    "markdown-it-plugin",
    "markdown-it",
    "markdown",
    "span"
  ],
  "homepage": "https://github.com/mb21/markdown-it-bracketed-spans",
  "repository": {
    "type": "git",
    "url": "git://github.com/mb21/markdown-it-bracketed-spans.git"
  },
  "bugs": {
    "url": "https://github.com/mb21/markdown-it-bracketed-spans/issues"
  },
  "license": "MIT",
  "author": "Mauro Bieg",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "npm run build:tsc && npm run build:post",
    "build:tsc": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json",
    "build:post": "node scripts/postbuild.mjs",
    "prebuild": "npm run clean",
    "clean": "rimraf dist",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "markdown-it": ">=13",
    "markdown-it-attrs": ">=4"
  },
  "peerDependenciesMeta": {
    "markdown-it-attrs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "dedent": "^1.7.2",
    "esbuild": "^0.28.1",
    "markdown-it": "^14.3.0",
    "markdown-it-attrs": "^5.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  }
}
